# ============================================================================
# 企业级 RAG 知识库问答系统 - 环境变量配置
# 使用方法：cp .env.example .env  然后按需修改（.env 已被 .gitignore 忽略，勿提交）
#
# ── 启动方式（均在仓库根目录执行）─────────────────────────────────────────
# 根目录 .env 内置 COMPOSE_FILE 指向 docker/ 下的两个编排文件，
# 因此 docker compose 无需 -f 参数即可加载全部编排定义。
#
# 【模式 A】仅启动中间件（postgres/redis/rabbitmq/minio），应用在本地 IDE 运行：
#     docker compose up -d
#
# 【模式 B】全容器化一键拉起（backend/worker/frontend 带 profiles=["app"]），二选一：
#     docker compose --profile app up -d
#     或去掉下面 COMPOSE_PROFILES 行的注释后再 docker compose up -d
#
# 【备选】在 docker/ 目录内直接操作时，必须显式 --env-file 指向根目录 .env，
#         否则 compose 的 ${VAR} 插值读不到根 .env（env_file 注入不受影响）：
#     模式 A：docker compose --env-file ../.env up -d
#     模式 B：docker compose --env-file ../.env -f docker-compose.yml -f docker-compose.app.yml --profile app up -d
#
# ── 地址约定 ──────────────────────────────────────────────────────────────
# 本文件中 URL 的主机统一为 localhost（模式 A 本地运行后端使用）；
# 模式 B 容器内地址（postgres/redis/rabbitmq/minio 等服务名）
# 由 docker/docker-compose.app.yml 的 environment 自动覆盖，无需手改。
# ============================================================================

# ---------- Compose 编排配置（compose 机制变量，非业务变量） ----------
# 让根目录的 docker compose 命令自动加载 docker/ 下的编排文件
# 分隔符注意：Windows 用分号(;)，Linux/macOS 用冒号(:)
COMPOSE_FILE=docker/docker-compose.yml;docker/docker-compose.app.yml
# 模式 B 开关：取消注释后 `docker compose up -d` 即包含 backend/worker/frontend
# COMPOSE_PROFILES=app

# ---------- PostgreSQL 16（pgvector + zhparser 自建镜像） ----------
POSTGRES_USER=kbase
POSTGRES_PASSWORD=kbase123
POSTGRES_DB=kbase

# ---------- SQLAlchemy 连接串（本地 IDE 运行 backend/worker 时使用；容器内由 compose 覆盖） ----------
DATABASE_URL=postgresql+psycopg2://kbase:kbase123@localhost:5432/kbase

# ---------- Redis 7（缓存 / Celery 结果后端） ----------
REDIS_URL=redis://localhost:6379/0

# ---------- RabbitMQ 3.13（Celery 消息队列；管理台 http://localhost:15672） ----------
RABBITMQ_DEFAULT_USER=kbase
RABBITMQ_DEFAULT_PASSWORD=kbase123
RABBITMQ_URL=amqp://kbase:kbase123@localhost:5672//

# ---------- MinIO（对象存储；控制台 http://localhost:9001） ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=kbase
MINIO_SECURE=false

# ---------- JWT 认证 ----------
# 生产环境务必更换为随机长串（如 python -c "import secrets;print(secrets.token_hex(32))"）
JWT_SECRET=4e40bd1d8bb9f9e39fe4eefc8fdec17dd0c6446ca8df0e2472dfcd893439dbf4
JWT_EXPIRE_MINUTES=120

# ---------- LLM（问答生成，OpenAI 兼容接口） ----------
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key
LLM_MODEL=gpt-4o-mini
# 多轮改写专用模型（留空用 LLM_MODEL）：改写是简单任务，主模型为思考型时建议配轻量非思考模型
REWRITE_MODEL=

# ---------- Embedding（向量化，OpenAI 兼容接口） ----------
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-your-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# 单次嵌入请求的最大文本条数（分批调用）。DashScope text-embedding-v4 上限为 10，
# OpenAI text-embedding-3 系列可到 2048，按供应商限制调整
EMBEDDING_BATCH_SIZE=10
# 嵌入分批请求的批间并发上限（多批同时请求以加速大文档入库；注意供应商限流）
EMBEDDING_MAX_CONCURRENCY=4

# ---------- Rerank（可选，留空则不启用重排） ----------
RERANK_API_BASE=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_TIMEOUT=5

# ---------- LangSmith 追踪（可选） ----------
# 配置 API Key 后，问答链路各阶段（query 改写/混合检索/向量/BM25/Rerank/
# LLM 提示词与输出/文档流水线）自动上报 LangSmith，可在网页查看每阶段耗时与内容
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=kbase-qa
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ---------- 检索与分块 ----------
# 全文检索用的 text search configuration（zhparser 就绪后为 chinese）
FTS_CONFIG=chinese
# 混合检索召回参数：向量路 / BM25 路各自召回 Top-K，RRF 融合后经 Rerank 截断 Top-N
VECTOR_TOP_K=10
KEYWORD_TOP_K=10
RERANK_TOP_N=10
# 相似度阈值（0~1）：向量路归一化相似度低于该值时 QA 可拒答
RELEVANCE_THRESHOLD=0.35
# PDF 图片 OCR（RapidOCR 本地识别扫描件/页面内图片；关闭后纯图片 PDF 解析为空）
PDF_OCR_ENABLED=true
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ---------- 业务限制 ----------
RATE_LIMIT_PER_MIN=10
MAX_UPLOAD_MB=50
HISTORY_ROUNDS=5

# ---------- 日志 ----------
LOG_LEVEL=INFO
